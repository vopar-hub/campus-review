{
  "permissions": {
    "allow": [
      "WebFetch(domain:github.com)",
      "Bash(./mvnw compile:*)",
      "Bash(mvn compile:*)",
      "Bash(netstat -ano)",
      "Bash(findstr :8105)",
      "Bash(tasklist)",
      "Bash(findstr 2248)",
      "Bash(cmd //c \"taskkill //PID 2248 //F\")",
      "Bash(findstr :8001)",
      "Bash(mvn clean:*)",
      "Bash(mvn --version)",
      "Bash(mvn test:*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -ExecutionPolicy Bypass -File \"E:\\\\_CODE_\\\\campus-review\\\\.claude\\\\hooks\\\\auto-git-commit.ps1\"",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
