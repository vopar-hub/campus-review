# ===============================
# Java/Spring Boot 项目 .gitignore
# ===============================

# Compiled class files
*.class

# Log files
*.log
logs/

# Package files
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# Maven
target/
pom.xml.tag
pom.xml.releaseBackup
pom.xml.versionsBackup
pom.xml.next
release.properties
dependency-reduced-pom.xml
buildNumber.properties
.mvn/timing.properties
.mvn/wrapper/maven-wrapper.jar

# Gradle (if used in future)
.gradle/
build/
!gradle/wrapper/gradle-wrapper.jar
!**/src/main/**/build/
!**/src/test/**/build/

# IDE - IntelliJ IDEA
.idea/
*.iml
*.iws
*.ipr
.out/
ideaOutputFolder/

# IDE - Eclipse
.classpath
.project
.settings/
.bin/

# IDE - VSCode
.vscode/*
!.vscode/extensions.json
!.vscode/tasks.json
!.vscode/launch.json

# Spring Boot specific
application-local.yml
application-local.properties
*.local.yml
*.local.properties

# Environment variables
.env
.env.local
.env.*.local

# Secrets and credentials
**/secret*
**/credentials*
**/*.keystore
**/*.jks

# Docker
*.pid
docker-compose.override.yml

# OS files
.DS_Store
Thumbs.db
Desktop.ini

# Temporary files
*.tmp
*.bak
*.swp
*~

# Native image (GraalVM)
*.pid
*.lib
*.a

# JRebel
**/rebel.xml

# JProfiler
.profiler/

# Flyway (if using local migrations)
**/db/migration/local/

# Test output
test-output/
surefire-reports/
failsafe-reports/

# Coverage
coverage/
*.exec
jacoco.exec
htmlcov/
.nyc_output/

# Frontend (has its own git repository)
campus-review-frontend/
/.claude/

/docs/
